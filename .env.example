# Website (Vercel/Netlify → Environment Variables).
# The anon key is safe in the browser: row level security is what protects the
# data, and schema.sql gives anon read-only access to published jobs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. Used by /api/submit to write employer submissions as pending.
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_KEY=eyJ...

# The poller (automation/) reads these from GitHub Actions, not from here.
# ANTHROPIC_API_KEY=
# FEED_CHANNELS=cd4cd,sharqiahjobs
